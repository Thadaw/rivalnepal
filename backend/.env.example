DATABASE_URL="postgresql://rivel:rivel@localhost:5432/rivelnepal"
# At least 32 random characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
# Comma separate to allow several storefront hosts, e.g. "https://rivalnepal.com,https://www.rivalnepal.com"
CLIENT_ORIGIN="http://localhost:5173"
PORT=4000
# `production` enables the secure SameSite=None session cookie; keep it `development` on localhost.
NODE_ENV="development"
# Used only by `npm run db:seed` to create the first admin
SEED_ADMIN_EMAIL="admin@rivalnepal.com"
SEED_ADMIN_PASSWORD=""
